{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "klickwerk",
  "version": "0.2.0",
  "identifier": "app.klickwerk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [{
      "label": "main", "title": "klickwerk", "width": 1080, "height": 820,
      "minWidth": 760, "minHeight": 640, "center": true, "backgroundColor": "#f8f9fc",
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["../assets/klickwerk.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
